# ── Lingorain environment variables ────────────────────────────────
# Copy this file to `.env` (local). Also copy the values into your
# Vercel project environment variables. Never commit real secrets.

# ── Database (required) ────────────────────────────────────────────
# App RUNTIME connection.
#   LOCAL dev:  DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#   VERCEL:     your Neon POOLED connection (has -pooler), e.g.
#               DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Direct (non-pooled) Neon connection. Use for manually controlled SQL migrations
# and one-off admin bootstrap commands. Vercel build does not change the database schema.
# DATABASE_DIRECT_URL=

# ── Security (required) ────────────────────────────────────────────
# Generate a strong value:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=
SESSION_SECRET=

# ── App (optional but recommended) ─────────────────────────────────
# Your production URL, e.g. https://your-app.vercel.app
APP_URL=https://your-app.vercel.app
# Public Jitsi host for Lingo Room (default: public Jitsi). For production use your own Jitsi host (hostname only).
JITSI_DOMAIN=

# ── Admin bootstrap (optional) ─────────────────────────────────────
# Set a unique admin bootstrap password (at least 16 characters); it is never logged.
# ADMIN_PASSWORD=
# ADMIN_EMAIL=admin@lingorain.com
# Set true ONLY if a trusted ingress overwrites X-Forwarded-For / X-Real-IP.
TRUST_PROXY_HEADERS=false

# ── Payments (optional, for real money) ────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# When set, real Stripe Checkout is used for top-ups. Leave empty to use simulated top-ups.

# ── Scheduled email reminders (required to send lesson reminders) ─────
# Vercel Cron automatically sends Authorization: Bearer $CRON_SECRET when CRON_SECRET is set.
# For another scheduler, configure it to send Authorization: Bearer $REMINDER_CRON_SECRET.
# Generate a random secret of 32+ bytes; never expose either secret via NEXT_PUBLIC_* variables.
CRON_SECRET=
REMINDER_CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM=

# Private Supabase Storage bucket for learning materials, teacher documents and avatars.
# Set its maximum file size to 25 MiB (or less); keep the bucket private.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lingorain-private

# Optional real-time classroom chat (configure in Admin → Integrations or set here)
REALTIME_PROVIDER=polling
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_CLUSTER=eu

# Optional distributed rate limiting (Admin → Integrations can store encrypted credentials instead).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
