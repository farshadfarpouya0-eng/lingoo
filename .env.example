# ── Database ───────────────────────────────────────────────
# ← از Neon: Connection Details → POOLED (داره -pooler)
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# ← از Neon: Connection Details → DIRECT (بدون -pooler)
DATABASE_DIRECT_URL=postgresql://USER:PASS@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Security ───────────────────────────────────────────────
INTEGRATION_ENCRYPTION_KEY=
SESSION_SECRET=

# ── اجرای migrate روی دیتابیس هاست‌شده (الزامی) ──────────
ALLOW_PRODUCTION_MIGRATIONS=true

# ── App ────────────────────────────────────────────────────
APP_URL=https://<آدرس-vercel-ات>.vercel.app
JITSI_DOMAIN=

# ── Cron / Email ───────────────────────────────────────────
CRON_SECRET=
REMINDER_CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM=

# ── Storage ────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lingorain-private

# ── Realtime ───────────────────────────────────────────────
REALTIME_PROVIDER=polling
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_CLUSTER=eu

# ── Rate limit ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=