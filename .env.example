# Lingorain local / hosted configuration template.
# Replace placeholders in your local ignored .env file or Vercel Environment Variables.
# Never put real credentials in Git.

# Neon PostgreSQL. Use the pooled endpoint for app requests and direct endpoint for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DB?sslmode=require
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require

# Required persistent secrets. Generate each value independently with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARS
PAYOUT_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
# For a fresh database, a separate key is recommended. Existing encrypted integrations
# may depend on SESSION_SECRET; do not change this without a data-key migration.
# INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_A_STABLE_RANDOM_SECRET_AT_LEAST_32_CHARS

# Canonical production URL (HTTPS origin only, no path or trailing route).
APP_URL=https://your-lingorain-domain.example

# Separate Cron authorization secrets.
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
REMINDER_CRON_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARS

# Optional provider credentials. These can also be configured in Admin > Integrations.
RESEND_API_KEY=
RESEND_FROM=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lingorain-private
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Production embedded video: auto | jaas | self-hosted | disabled.
# No anonymous meet.jit.si fallback is allowed (it disconnects embedded calls after 5 minutes).
VIDEO_PROVIDER=auto
# Recommended: create an application and RSA API key at https://jaas.8x8.vc/
JAAS_APP_ID=
JAAS_API_KEY_ID=
# PEM private key; use \n for line breaks when supplying a single-line environment value.
JAAS_PRIVATE_KEY=
# Alternative: your own Jitsi deployment with Prosody JWT auth and allow_empty_token=false.
# Set JITSI_DOMAIN in hosting environment as well so CSP and media permissions allow it.
JITSI_DOMAIN=
JITSI_APP_ID=lingorain
JITSI_APP_SECRET=
# Existing alternative video provider; recording still needs webhook setup and consent.
RECORDING_PROVIDER=disabled
DAILY_API_KEY=
DAILY_DOMAIN=
DAILY_WEBHOOK_PASSWORD=
DAILY_WEBHOOK_ID=
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_CLUSTER=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional connection tuning.
DB_POOL_MAX=2
DB_CONNECT_TIMEOUT_MS=15000
# Set to true only behind a trusted reverse proxy that strips spoofed forwarded headers.
# Vercel's ingress headers are recognized automatically.
# TRUST_PROXY_HEADERS=false

# Keep all demo options off in hosted environments.
ENABLE_DEMO_DATA=false
ENABLE_DEMO_PAYMENTS=false
ENABLE_ADMIN_IMPERSONATION=false

# Optional cryptocurrency wallet top-ups. Provider secrets can also be saved encrypted in Admin → Integrations. Direct wallet fields are public receiving addresses only.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
PLISIO_SECRET_KEY=
# Direct public receiving addresses only; never private keys or recovery phrases.
CRYPTO_DIRECT_USDT_TRC20=
CRYPTO_DIRECT_USDT_BEP20=
CRYPTO_DIRECT_BNB_BEP20=
CRYPTO_DIRECT_TRX_TRON=
